generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())

  fullName    String
  email       String   @unique
  password    String

  college     String?
  skills      String?
  role        String?
  location    String?
  bio         String?
  experience  String?
  resumeUrl   String?

  createdAt   DateTime @default(now())
}